# Long random secret. Paste the same value into Finsuma the first time you download.
# Generate one with:  openssl rand -base64 18
YT_TOKEN=change-me

# Folder that holds your music library. Navidrome reads it; downloads go to ./YouTube inside it.
MUSIC_DIR=/path/to/Music

# User and group that own MUSIC_DIR (run `id` to see yours).
PUID=1000
PGID=1000

# Port Finsuma talks to.
YT_PORT=3200
